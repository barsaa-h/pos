# POS System Environment Configuration
# Copy this to .env and fill in your values

# Flask secret key (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
POS_SECRET_KEY=change-me-to-a-random-string

# Database path (default: pos.db in project directory)
POS_DB_PATH=data/pos.db

# eBarimt API Configuration
EBARIMT_API_URL=https://merchant.ebarimt.mn
EBARIMT_MERCHANT_TIN=
EBARIMT_TTD=
EBARIMT_BRANCH_ID=

# Printer
PRINTER_PORT=/dev/usb/lp0

# Store info
STORE_NAME=Миний дэлгүүр
STORE_ADDRESS=Улаанбаатар
STORE_PHONE=70112233