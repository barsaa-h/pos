[Unit]
Description=Миний дэлгүүр POS System
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/minii-delguur
ExecStart=/opt/minii-delguur/venv/bin/python3 /opt/minii-delguur/ubuntu/desktop.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target